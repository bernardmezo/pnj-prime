# ============================================================
# PNJ PRIME — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ============================================================

APP_NAME="PNJ Prime"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Database — PostgreSQL (recommended)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pnj_prime
DB_USERNAME=postgres
DB_PASSWORD=

# Alternatively, MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pnj_prime
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# Mail — configure when email notifications are implemented
# ============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pnjprime.pnj.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# File Storage — for payment proof uploads
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# SSO PNJ — PLACEHOLDER (TBD, Bab 7.3 & Bab 14)
# Uncomment and fill when SSO integration is ready.
# ============================================================
# SSO_PNJ_CLIENT_ID=
# SSO_PNJ_CLIENT_SECRET=
# SSO_PNJ_REDIRECT_URI="${APP_URL}/auth/sso/callback"
# SSO_PNJ_ENDPOINT=https://sso.pnj.ac.id

# ============================================================
# Payment Gateway — PLACEHOLDER (Out-of-scope phase ini, Bab 5.2)
# Uncomment when real-time payment gateway integration is added.
# ============================================================
# PAYMENT_GATEWAY_PROVIDER=midtrans   # or xendit, doku, etc.
# PAYMENT_GATEWAY_SERVER_KEY=
# PAYMENT_GATEWAY_CLIENT_KEY=
# PAYMENT_GATEWAY_ENV=sandbox         # sandbox | production

VITE_APP_NAME="${APP_NAME}"
